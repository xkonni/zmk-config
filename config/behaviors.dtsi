 *
 * Shared custom behaviors for all keyboards.
 * Each keymap must include the appropriate key-labels header before this file
 * to supply KEYS_L, KEYS_R and THUMBS for the HRM hold-trigger-key-positions.
 */

/ {
    behaviors {
        hml: behavior_hold_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;           // if a key is released within this time, it will always register as a tap (default 0, disabled)
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>; // Trigger hold when pressing opposite hand (prevents accidental mods on single hand)
            hold-trigger-on-release;        // Trigger hold on key release (instead of key press)
        };

        /* A: left-hand rolls stay A; only shifted punctuation triggers hold. */
        hml_a: behavior_hold_tap_a {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <225>;
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RB2 RB3 RB4>;
            hold-trigger-on-release;
        };

        /* Right-hand HRMs. */
        hmr: behavior_hold_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;           // if a key is released within this time, it will always register as a tap (default 0, disabled)
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>; // Trigger hold when pressing opposite hand (prevents accidental mods on single hand)
            hold-trigger-on-release;        // Trigger hold on key release (instead of key press)
        };

        /* ModTap slow, with high tapping term */
        mts: behavior_mts {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;        // how long a key needs to be pressed to register as a hold (default 200)
            quick-tap-ms = <200>;           // if a key is released within this time, it will always register as a tap (default 0, disabled)
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;        // Trigger hold on key release (instead of key press)
        };

        /* Layer tap with quick-tap-ms. */
        ltq: behavior_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;        // how long a key needs to be pressed to register as a hold (default 200)
            quick-tap-ms = <175>;           // if a key is released within this time, it will always register as a tap (default 0, disabled)
            bindings = <&mo>, <&kp>;
        };

        /* Mod tap with quick-tap-ms. */
        mtq: behavior_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;        // how long a key needs to be pressed to register as a hold (default 200)
            quick-tap-ms = <175>;           // if a key is released within this time, it will always register as a tap (default 0, disabled)
            bindings = <&kp>, <&kp>;
        };

        /* LayerTap slow, with high tapping term */
        lts: behavior_lts {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;        // how long a key needs to be pressed to register as a hold (default 200)
            quick-tap-ms = <200>;           // if a key is released within this time, it will always register as a tap (default 0, disabled)
            bindings = <&mo>, <&kp>;
            hold-trigger-on-release;        // Trigger hold on key release (instead of key press)
        };

        /* LALT on tap/hold, momentary alt-number layer on double-tap/hold */
        td_lalt: tap_dance_lalt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LALT>, <&mo 7>;
        };

        /* X: tap X, double-tap one-shot Ctrl. */
        td_x: tap_dance_x {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp X>, <&sk LCTRL>;
        };
    };
};
