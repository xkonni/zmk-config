#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &default_layout;
        zephyr,display = &oled;
        zmk,underglow = &led_strip;
    };

    mock_kscan: mock_kscan {
        compatible = "zmk,kscan-mock";
        rows = <0>;
        columns = <0>;
        events = <>;
    };

    /*
     * 38 keys: left 19 (0-18), right 19 (19-37)
     *
     * Row 0 (5+5):  [0..4]   [19..23]
     * Row 1 (5+5):  [5..9]   [24..28]
     * Row 2 (6+6):  [10..15] [29..34]
     * Thumbs (3+3): [16..18] [35..37]
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <38>;
        rows = <1>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)            RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23)
            RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)            RC(0,24) RC(0,25) RC(0,26) RC(0,27) RC(0,28)
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)  RC(0,29) RC(0,30) RC(0,31) RC(0,32) RC(0,33) RC(0,34)
                                        RC(0,16) RC(0,17) RC(0,18)  RC(0,35) RC(0,36) RC(0,37)
        >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        keys //                     w    h    x    y  rot  rx  ry
            = <&key_physical_attrs 105 100   77 151 (-1000)  130  201> /* Q  */
            , <&key_physical_attrs 105 100  196  60  (-400)  249  110> /* W  */
            , <&key_physical_attrs 105 100  317   0     0    0    0> /* E  */
            , <&key_physical_attrs 105 100  423  49     0    0    0> /* R  */
            , <&key_physical_attrs 105 100  529  65     0    0    0> /* T  */
            , <&key_physical_attrs 105 100  868  65     0    0    0> /* Y  */
            , <&key_physical_attrs 105 100  974  49     0    0    0> /* U  */
            , <&key_physical_attrs 105 100 1080   0     0    0    0> /* I  */
            , <&key_physical_attrs 105 100 1200  60   400 1253  110> /* O  */
            , <&key_physical_attrs 105 100 1319 152  1000 1372  202> /* P  */
            , <&key_physical_attrs 105 100   95 250 (-1000)  147  300> /* A  */
            , <&key_physical_attrs 105 100  203 160  (-400)  256  210> /* S  */
            , <&key_physical_attrs 105 100  317 100     0    0    0> /* D  */
            , <&key_physical_attrs 105 100  423 149     0    0    0> /* F  */
            , <&key_physical_attrs 105 100  529 165     0    0    0> /* G  */
            , <&key_physical_attrs 105 100  868 166     0    0    0> /* H  */
            , <&key_physical_attrs 105 100  974 149     0    0    0> /* J  */
            , <&key_physical_attrs 105 100 1080 100     0    0    0> /* K  */
            , <&key_physical_attrs 105 100 1193 160   400 1246  210> /* L  */
            , <&key_physical_attrs 105 100 1302 250  1000 1355  300> /* ;  */
            , <&key_physical_attrs 105 100    0 323 (-1000)   52  373> /* LB5 (none) */
            , <&key_physical_attrs 105 100  112 348 (-1000)  165  398> /* Z  */
            , <&key_physical_attrs 105 100  210 260  (-400)  263  310> /* X  */
            , <&key_physical_attrs 105 100  317 200     0    0    0> /* C  */
            , <&key_physical_attrs 105 100  423 249     0    0    0> /* V  */
            , <&key_physical_attrs 105 100  529 265     0    0    0> /* B  */
            , <&key_physical_attrs 105 100  868 266     0    0    0> /* N  */
            , <&key_physical_attrs 105 100  974 249     0    0    0> /* M  */
            , <&key_physical_attrs 105 100 1080 200     0    0    0> /* ,  */
            , <&key_physical_attrs 105 100 1186 260   400 1239  310> /* .  */
            , <&key_physical_attrs 105 100 1285 349  1000 1338  399> /* /  */
            , <&key_physical_attrs 105 100 1397 323  1000 1450  373> /* RB5 (none) */
            , <&key_physical_attrs 105 100  393 371     0    0    0> /* lalt */
            , <&key_physical_attrs 105 100  511 387  1500  563  437> /* mo1 */
            , <&key_physical_attrs 105 100  619 432  3000  672  482> /* space */
            , <&key_physical_attrs 105 100  778 432 (-3000)  831  482> /* ret */
            , <&key_physical_attrs 105 100  886 387 (-1500)  939  437> /* mo2 */
            , <&key_physical_attrs 105 100 1003 371     0    0    0> /* ralt */
            ;
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;
    };
};
