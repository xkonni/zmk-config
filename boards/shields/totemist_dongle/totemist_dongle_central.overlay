#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &default_layout;
        zephyr,display = &oled;
        zmk,underglow = &led_strip;
    };

    mock_kscan: mock_kscan {
        compatible = "zmk,kscan-mock";
        rows = <0>;
        columns = <0>;
        events = <>;
    };

    /*
     * 38 keys: left 19 (0-18), right 19 (19-37)
     *
     * Row 0 (5+5):  [0..4]   [19..23]
     * Row 1 (5+5):  [5..9]   [24..28]
     * Row 2 (6+6):  [10..15] [29..34]
     * Thumbs (3+3): [16..18] [35..37]
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <38>;
        rows = <1>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)            RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23)
            RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)            RC(0,24) RC(0,25) RC(0,26) RC(0,27) RC(0,28)
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)  RC(0,29) RC(0,30) RC(0,31) RC(0,32) RC(0,33) RC(0,34)
                                        RC(0,16) RC(0,17) RC(0,18)  RC(0,35) RC(0,36) RC(0,37)
        >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        keys //                     w    h    x    y  rot  rx  ry
            = <&key_physical_attrs 100  100  100  200    0   0   0>  /* Q  */
            , <&key_physical_attrs 100  100  200   75    0   0   0>  /* W  */
            , <&key_physical_attrs 100  100  300    0    0   0   0>  /* E  */
            , <&key_physical_attrs 100  100  400   50    0   0   0>  /* R  */
            , <&key_physical_attrs 100  100  500  100    0   0   0>  /* T  */
            , <&key_physical_attrs 100  100  100  300    0   0   0>  /* A  */
            , <&key_physical_attrs 100  100  200  175    0   0   0>  /* S  */
            , <&key_physical_attrs 100  100  300  100    0   0   0>  /* D  */
            , <&key_physical_attrs 100  100  400  150    0   0   0>  /* F  */
            , <&key_physical_attrs 100  100  500  200    0   0   0>  /* G  */
            , <&key_physical_attrs 100  100    0  400    0   0   0>  /* LB5 (none) */
            , <&key_physical_attrs 100  100  100  400    0   0   0>  /* Z  */
            , <&key_physical_attrs 100  100  200  275    0   0   0>  /* X  */
            , <&key_physical_attrs 100  100  300  200    0   0   0>  /* C  */
            , <&key_physical_attrs 100  100  400  250    0   0   0>  /* V  */
            , <&key_physical_attrs 100  100  500  300    0   0   0>  /* B  */
            , <&key_physical_attrs 100  100  350  475    0   0   0>  /* lalt */
            , <&key_physical_attrs 100  100  460  460    0   0   0>  /* mo1 */
            , <&key_physical_attrs 100  100  575  440    0   0   0>  /* space */
            , <&key_physical_attrs 100  100  725  100    0   0   0>  /* Y  */
            , <&key_physical_attrs 100  100  825   50    0   0   0>  /* U  */
            , <&key_physical_attrs 100  100  925    0    0   0   0>  /* I  */
            , <&key_physical_attrs 100  100 1025   75    0   0   0>  /* O  */
            , <&key_physical_attrs 100  100 1125  200    0   0   0>  /* P  */
            , <&key_physical_attrs 100  100  725  200    0   0   0>  /* H  */
            , <&key_physical_attrs 100  100  825  150    0   0   0>  /* J  */
            , <&key_physical_attrs 100  100  925  100    0   0   0>  /* K  */
            , <&key_physical_attrs 100  100 1025  175    0   0   0>  /* L  */
            , <&key_physical_attrs 100  100 1125  300    0   0   0>  /* ;  */
            , <&key_physical_attrs 100  100  725  300    0   0   0>  /* N  */
            , <&key_physical_attrs 100  100  825  250    0   0   0>  /* M  */
            , <&key_physical_attrs 100  100  925  200    0   0   0>  /* ,  */
            , <&key_physical_attrs 100  100 1025  275    0   0   0>  /* .  */
            , <&key_physical_attrs 100  100 1125  400    0   0   0>  /* /  */
            , <&key_physical_attrs 100  100 1225  400    0   0   0>  /* RB5 (none) */
            , <&key_physical_attrs 100  100  625  440    0   0   0>  /* ret */
            , <&key_physical_attrs 100  100  740  460    0   0   0>  /* mo2 */
            , <&key_physical_attrs 100  100  850  475    0   0   0>  /* ralt */
            ;
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;
    };
};
